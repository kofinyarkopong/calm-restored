# Copy to .env.local for local development, and add the same values in
# Vercel: Project → Settings → Environment Variables.

# Resend API key (https://resend.com → API Keys)
RESEND_API_KEY=

# Where enquiries are delivered (comma-separate for more than one)
CONTACT_EMAIL=

# Sender on a domain verified in Resend, for example:
# Calm Restored <enquiries@calmrestored.com.gh>
CONTACT_FROM_EMAIL=

# Public address of the site (used for canonical links, sitemap and sharing)
NEXT_PUBLIC_SITE_URL=https://calmrestoredgh.vercel.app
